{
  "name": "my-soccer-coach",
  "version": "1.0.0",
  "description": "My Soccer Coach app",
  "main": "app.js",
  "scripts": {
    "build:css": "npx tailwindcss -i ./src/tailwind.css -o ./tailwind.css",
    "dev:css": "npx tailwindcss -i ./src/tailwind.css -o ./tailwind.css --watch",
    "build": "npm run build:css && rm -rf dist && mkdir dist && cp app.html dist/index.html && cp -r js img icons styles.css tailwind.css manifest.json sw.js dist/"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "jsdom": "^30.0.1"
  }
}
